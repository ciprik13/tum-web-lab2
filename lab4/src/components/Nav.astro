---
// Nav.astro
---

<header
  class="navbar fixed top-0 inset-x-0 z-[1000] bg-white/95 backdrop-blur-[20px] border-b border-transparent py-3.5 transition-all duration-300"
  id="navbar"
>
  <div class="max-w-[1200px] mx-auto px-6 flex items-center gap-5">

    <a href="#hero" class="shrink-0 flex items-center font-extrabold text-[1.15rem] lg:text-[1.2rem] text-primary tracking-tight gap-2.5 whitespace-nowrap">
      <img
        src="/assets/logo1.png"
        alt="Logo Darion-Nord"
        class="h-12 transition-all duration-300 logo-img"
      />
      <span>DARION-NORD</span>
    </a>

    <nav class="nav-menu md:flex md:min-w-0 md:ml-6" id="navMenu">
      <ul class="flex items-center gap-1.5 lg:gap-2 flex-nowrap max-md:flex-col max-md:gap-2">
        <li>
          <a href="#despre" class="nav-link whitespace-nowrap font-medium text-[0.96rem] text-slate-700 px-3.5 py-2.5 rounded-lg transition-all duration-300 hover:text-primary hover:bg-primary/5 max-md:text-base max-md:py-3 max-md:px-4 max-md:w-full max-md:block" data-i18n="nav_about">Despre Noi</a>
        </li>
        <li>
          <a href="#servicii" class="nav-link whitespace-nowrap font-medium text-[0.96rem] text-slate-700 px-3.5 py-2.5 rounded-lg transition-all duration-300 hover:text-primary hover:bg-primary/5 max-md:text-base max-md:py-3 max-md:px-4 max-md:w-full max-md:block" data-i18n="nav_services">Servicii</a>
        </li>
        <li>
          <a href="#proces" class="nav-link whitespace-nowrap font-medium text-[0.96rem] text-slate-700 px-3.5 py-2.5 rounded-lg transition-all duration-300 hover:text-primary hover:bg-primary/5 max-md:text-base max-md:py-3 max-md:px-4 max-md:w-full max-md:block" data-i18n="nav_process">Cum Lucrăm</a>
        </li>
        <li>
          <a href="#avantaje" class="nav-link whitespace-nowrap font-medium text-[0.96rem] text-slate-700 px-3.5 py-2.5 rounded-lg transition-all duration-300 hover:text-primary hover:bg-primary/5 max-md:text-base max-md:py-3 max-md:px-4 max-md:w-full max-md:block" data-i18n="nav_advantages">Avantaje</a>
        </li>
        <li>
          <a href="#proiecte" class="nav-link whitespace-nowrap font-medium text-[0.96rem] text-slate-700 px-3.5 py-2.5 rounded-lg transition-all duration-300 hover:text-primary hover:bg-primary/5 max-md:text-base max-md:py-3 max-md:px-4 max-md:w-full max-md:block" data-i18n="nav_projects">Proiecte</a>
        </li>
        <li>
          <a href="#contact" class="nav-link btn-nav shrink-0 whitespace-nowrap bg-primary text-white px-5 py-2.5 rounded-lg font-medium text-[0.96rem] transition-all duration-300 hover:bg-primary-light hover:-translate-y-px hover:shadow-[0_4px_12px_rgba(15,29,53,0.3)] max-md:text-center max-md:mt-2 max-md:block" data-i18n="nav_contact">Contactează-ne</a>
        </li>
      </ul>
    </nav>

    <a href="tel:+37369570971" class="hidden items-center shrink-0 whitespace-nowrap gap-1.5 px-3 py-1.5 ml-auto text-[0.9rem] font-semibold transition-all duration-300 border-2 rounded-lg text-primary border-primary hover:bg-primary hover:text-white">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      +373 69 570 971
    </a>

    <div class="ml-3 lang-switcher shrink-0" id="langSwitcher">
      <button class="lang-btn" data-lang="ro">RO</button>
      <button class="lang-btn" data-lang="en">EN</button>
      <button class="lang-btn" data-lang="ru">RU</button>
    </div>

    <button
      class="hamburger flex md:hidden flex-col gap-[5px] bg-transparent border-none cursor-pointer p-2 z-[1001]"
      id="hamburger"
      aria-label="Meniu"
      data-i18n-aria="nav_menu"
    >
      <span class="block w-6 h-0.5 bg-primary transition-all duration-300 rounded-sm"></span>
      <span class="block w-6 h-0.5 bg-primary transition-all duration-300 rounded-sm"></span>
      <span class="block w-6 h-0.5 bg-primary transition-all duration-300 rounded-sm"></span>
    </button>

  </div>
</header>