---
// Proces.astro
---

<section id="proces" class="py-[100px] max-md:py-[60px] bg-primary">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="text-center mb-[60px] animate-on-scroll">
      <span
        class="inline-block text-[0.8rem] font-bold uppercase tracking-[0.15em] text-accent bg-accent/15 px-4 py-1.5 rounded-full mb-4"
        data-i18n="process_badge"
        >Procesul nostru</span
      >
      <h2
        class="text-[clamp(1.8rem,3.5vw,2.5rem)] font-extrabold text-white mb-3 tracking-tight leading-[1.2]"
        data-i18n="process_title"
      >
        Cum Lucrăm
      </h2>
      <p
        class="text-[1.05rem] text-white/60 max-w-[550px] mx-auto leading-[1.7]"
        data-i18n="process_sub"
      >
        4 pași simpli de la idee la realitate
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
      <!-- Step 1 -->
      <div
        class="group relative rounded-2xl overflow-hidden h-[380px] max-lg:h-[420px] max-md:h-[360px] transition-all duration-300 shadow-[0_10px_40px_rgba(0,0,0,0.1)] hover:-translate-y-2 hover:shadow-[0_20px_60px_rgba(0,0,0,0.12)] animate-on-scroll"
        style="--delay: 0s"
      >
        <div class="process-bg-1 absolute inset-0 transition-transform duration-[600ms] group-hover:scale-[1.08]"></div>
        <div class="process-card-overlay relative h-full p-8 pb-7 flex flex-col justify-between z-[2]">
          <div class="self-start mb-4">
            <span class="inline-flex items-center justify-center w-[60px] h-[60px] bg-accent/20 backdrop-blur-[10px] border-2 border-accent rounded-full text-2xl font-black text-accent transition-all duration-300 group-hover:bg-accent group-hover:text-primary group-hover:scale-110 group-hover:shadow-[0_6px_25px_rgba(240,185,11,0.5)]">01</span>
          </div>
          <div>
            <h4 class="text-[1.3rem] font-extrabold text-white mb-3 leading-[1.3]" data-i18n="process_1_title">Pregătirea și Demolarea</h4>
            <p class="text-[0.95rem] text-white/85 leading-[1.7] mb-5 flex-1" data-i18n="process_1_desc">
              Analizăm amplasamentul și oferim servicii de curățare, demolare a structurilor vechi și nivelare a solului pentru a pregăti terenul de construcție.
            </p>
          </div>
          <div class="flex items-center self-end justify-center w-12 h-12 transition-all duration-300 rounded-full bg-accent/15 text-accent group-hover:bg-accent group-hover:text-primary group-hover:translate-x-1">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </div>
      </div>

      <!-- Step 2 -->
      <div
        class="group relative rounded-2xl overflow-hidden h-[380px] max-lg:h-[420px] max-md:h-[360px] transition-all duration-300 shadow-[0_10px_40px_rgba(0,0,0,0.1)] hover:-translate-y-2 hover:shadow-[0_20px_60px_rgba(0,0,0,0.12)] animate-on-scroll"
        style="--delay: 0.15s"
      >
        <div class="process-bg-2 absolute inset-0 transition-transform duration-[600ms] group-hover:scale-[1.08]"></div>
        <div class="process-card-overlay relative h-full p-8 pb-7 flex flex-col justify-between z-[2]">
          <div class="self-start mb-4">
            <span class="inline-flex items-center justify-center w-[60px] h-[60px] bg-accent/20 backdrop-blur-[10px] border-2 border-accent rounded-full text-2xl font-black text-accent transition-all duration-300 group-hover:bg-accent group-hover:text-primary group-hover:scale-110 group-hover:shadow-[0_6px_25px_rgba(240,185,11,0.5)]">02</span>
          </div>
          <div>
            <h4 class="text-[1.3rem] font-extrabold text-white mb-3 leading-[1.3]" data-i18n="process_2_title">Ridicarea Structurii</h4>
            <p class="text-[0.95rem] text-white/85 leading-[1.7] mb-5 flex-1" data-i18n="process_2_desc">
              Executăm structura de rezistență (beton sau metal) folosind materiale certificate și tehnici riguroase care respectă normativele tehnice în vigoare.
            </p>
          </div>
          <div class="flex items-center self-end justify-center w-12 h-12 transition-all duration-300 rounded-full bg-accent/15 text-accent group-hover:bg-accent group-hover:text-primary group-hover:translate-x-1">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </div>
      </div>

      <!-- Step 3 -->
      <div
        class="group relative rounded-2xl overflow-hidden h-[380px] max-lg:h-[420px] max-md:h-[360px] transition-all duration-300 shadow-[0_10px_40px_rgba(0,0,0,0.1)] hover:-translate-y-2 hover:shadow-[0_20px_60px_rgba(0,0,0,0.12)] animate-on-scroll"
        style="--delay: 0.3s"
      >
        <div class="process-bg-3 absolute inset-0 transition-transform duration-[600ms] group-hover:scale-[1.08]"></div>
        <div class="process-card-overlay relative h-full p-8 pb-7 flex flex-col justify-between z-[2]">
          <div class="self-start mb-4">
            <span class="inline-flex items-center justify-center w-[60px] h-[60px] bg-accent/20 backdrop-blur-[10px] border-2 border-accent rounded-full text-2xl font-black text-accent transition-all duration-300 group-hover:bg-accent group-hover:text-primary group-hover:scale-110 group-hover:shadow-[0_6px_25px_rgba(240,185,11,0.5)]">03</span>
          </div>
          <div>
            <h4 class="text-[1.3rem] font-extrabold text-white mb-3 leading-[1.3]" data-i18n="process_3_title">Sisteme și Utilități</h4>
            <p class="text-[0.95rem] text-white/85 leading-[1.7] mb-5 flex-1" data-i18n="process_3_desc">
              Implementăm rețelele de apă, canalizare, electricitate și încălzire, transformând structura brută într-un spațiu funcțional și eficient energetic.
            </p>
          </div>
          <div class="flex items-center self-end justify-center w-12 h-12 transition-all duration-300 rounded-full bg-accent/15 text-accent group-hover:bg-accent group-hover:text-primary group-hover:translate-x-1">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </div>
      </div>

      <!-- Step 4 -->
      <div
        class="group relative rounded-2xl overflow-hidden h-[380px] max-lg:h-[420px] max-md:h-[360px] transition-all duration-300 shadow-[0_10px_40px_rgba(0,0,0,0.1)] hover:-translate-y-2 hover:shadow-[0_20px_60px_rgba(0,0,0,0.12)] animate-on-scroll"
        style="--delay: 0.45s"
      >
        <div class="process-bg-4 absolute inset-0 transition-transform duration-[600ms] group-hover:scale-[1.08]"></div>
        <div class="process-card-overlay relative h-full p-8 pb-7 flex flex-col justify-between z-[2]">
          <div class="self-start mb-4">
            <span class="inline-flex items-center justify-center w-[60px] h-[60px] bg-accent/20 backdrop-blur-[10px] border-2 border-accent rounded-full text-2xl font-black text-accent transition-all duration-300 group-hover:bg-accent group-hover:text-primary group-hover:scale-110 group-hover:shadow-[0_6px_25px_rgba(240,185,11,0.5)]">04</span>
          </div>
          <div>
            <h4 class="text-[1.3rem] font-extrabold text-white mb-3 leading-[1.3]" data-i18n="process_4_title">Finisaje și Predare</h4>
            <p class="text-[0.95rem] text-white/85 leading-[1.7] mb-5 flex-1" data-i18n="process_4_desc">
              Realizăm lucrările de estetică și finisajele profesionale. Predăm proiectul la cheie, garantând durabilitatea execuției și a materialelor folosite.
            </p>
          </div>
          <div class="flex items-center self-end justify-center w-12 h-12 text-green-500 transition-all duration-300 rounded-full bg-green-500/20 group-hover:bg-green-500 group-hover:text-white group-hover:scale-110">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>