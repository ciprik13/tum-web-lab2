---
const { data } = Astro.props;

const sectionBadge = data?.process_badge ?? "Procesul nostru";
const sectionTitle = data?.process_title ?? "Cum Lucram";
const sectionSubtitle = data?.process_sub ?? "4 pasi simpli de la idee la realitate";

const steps = [
  { title: data?.process_1_title, desc: data?.process_1_desc },
  { title: data?.process_2_title, desc: data?.process_2_desc },
  { title: data?.process_3_title, desc: data?.process_3_desc },
  { title: data?.process_4_title, desc: data?.process_4_desc },
].filter((step) => step?.title && step?.desc);

const bgClasses = ["process-bg-1", "process-bg-2", "process-bg-3", "process-bg-4"];
---

<section id="proces" class="py-[100px] max-md:py-[60px] bg-primary">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="text-center mb-[60px] animate-on-scroll">
      <span class="inline-block text-[0.8rem] font-bold uppercase tracking-[0.15em] text-accent bg-accent/15 px-4 py-1.5 rounded-full mb-4">
        {sectionBadge}
      </span>
      <h2 class="text-[clamp(1.8rem,3.5vw,2.5rem)] font-extrabold text-white mb-3 tracking-tight leading-[1.2]">
        {sectionTitle}
      </h2>
      <p class="text-[1.05rem] text-white/60 max-w-[550px] mx-auto leading-[1.7]">
        {sectionSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
      {steps.map((step, index) => {
        const isLast = index === steps.length - 1;
        return (
          <div
            class="group relative rounded-2xl overflow-hidden h-[380px] max-lg:h-[420px] max-md:h-[360px] transition-all duration-300 shadow-[0_10px_40px_rgba(0,0,0,0.1)] hover:-translate-y-2 hover:shadow-[0_20px_60px_rgba(0,0,0,0.12)] animate-on-scroll"
            style={`--delay: ${index * 0.15}s`}
          >
            <div class={`absolute inset-0 transition-transform duration-[600ms] group-hover:scale-[1.08] ${bgClasses[index % bgClasses.length]}`}></div>
            <div class="process-card-overlay relative h-full p-8 pb-7 flex flex-col justify-between z-[2]">
              <div class="self-start mb-4">
                <span class="inline-flex items-center justify-center w-[60px] h-[60px] bg-accent/20 backdrop-blur-[10px] border-2 border-accent rounded-full text-2xl font-black text-accent transition-all duration-300 group-hover:bg-accent group-hover:text-primary group-hover:scale-110 group-hover:shadow-[0_6px_25px_rgba(240,185,11,0.5)]">
                  {String(index + 1).padStart(2, "0")}
                </span>
              </div>
              <div>
                <h4 class="text-[1.3rem] font-extrabold text-white mb-3 leading-[1.3]">{step.title}</h4>
                <p class="text-[0.95rem] text-white/85 leading-[1.7] mb-5 flex-1">{step.desc}</p>
              </div>

              {isLast ? (
                <div class="flex items-center self-end justify-center w-12 h-12 text-green-500 transition-all duration-300 rounded-full bg-green-500/20 group-hover:bg-green-500 group-hover:text-white group-hover:scale-110">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
              ) : (
                <div class="flex items-center self-end justify-center w-12 h-12 transition-all duration-300 rounded-full bg-accent/15 text-accent group-hover:bg-accent group-hover:text-primary group-hover:translate-x-1">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
