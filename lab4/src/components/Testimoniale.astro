      </div>
    </div>
  </div>
</section>

<!-- CTA Banner -->
<section class="cta-banner relative overflow-hidden min-h-[500px] flex items-center">
  <div class="relative z-[2] max-w-[1200px] mx-auto px-6 py-[100px]">
    <h2 class="text-[clamp(2.2rem,4vw,3.2rem)] font-black text-white mb-5 tracking-tight leading-[1.2] text-center animate-on-scroll" data-i18n="cta_title">Ai un proiect în minte?</h2>
    <p class="text-[1.2rem] text-white/85 mb-12 max-w-[700px] mx-auto leading-[1.7] text-center animate-on-scroll" style="--delay: 0.1s" data-i18n="cta_desc">Contactează-ne astăzi și primești o consultație gratuită! Transformăm viziunea ta în realitate cu soluții complete și profesionale.</p>
    <div class="flex gap-5 justify-center flex-wrap mb-[60px] max-md:flex-col max-md:items-stretch animate-on-scroll" style="--delay: 0.2s">
      <a href="#contact" class="inline-flex items-center gap-2.5 bg-gradient-to-br from-accent to-accent-light text-primary px-10 py-[18px] font-bold text-[1.05rem] rounded-lg transition-all duration-300 shadow-[0_4px_20px_rgba(240,185,11,0.3)] hover:shadow-[0_8px_30px_rgba(240,185,11,0.5)] hover:-translate-y-[3px] justify-center">
        <span data-i18n="cta_btn_offer">Solicită Ofertă</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
