        <div class="shrink-0 w-[260px] max-lg:w-[160px] max-md:w-[140px] h-[160px] max-lg:h-[100px] max-md:h-[90px] bg-white rounded-xl flex items-center justify-center p-8 border border-slate-200 transition-all duration-300 shadow-[0_1px_3px_rgba(0,0,0,0.08)] hover:-translate-y-1.5 hover:shadow-[0_10px_40px_rgba(0,0,0,0.1)] hover:border-accent"><img src="/assets/logo-agroelit.png" alt="AGROelit" class="max-w-full max-h-[95px] max-lg:max-h-[60px] max-md:max-h-[50px] object-contain grayscale opacity-70 transition-all duration-300 hover:grayscale-0 hover:opacity-100" onerror="this.src='/assets/logo1.png'" /></div>
        <div class="shrink-0 w-[260px] max-lg:w-[160px] max-md:w-[140px] h-[160px] max-lg:h-[100px] max-md:h-[90px] bg-white rounded-xl flex items-center justify-center p-8 border border-slate-200 transition-all duration-300 shadow-[0_1px_3px_rgba(0,0,0,0.08)] hover:-translate-y-1.5 hover:shadow-[0_10px_40px_rgba(0,0,0,0.1)] hover:border-accent"><img src="/assets/logo-beermaster.png" alt="Beermaster Brewery" class="max-w-full max-h-[95px] max-lg:max-h-[60px] max-md:max-h-[50px] object-contain grayscale opacity-70 transition-all duration-300 hover:grayscale-0 hover:opacity-100" onerror="this.src='/assets/logo1.png'" /></div>
        <div class="shrink-0 w-[260px] max-lg:w-[160px] max-md:w-[140px] h-[160px] max-lg:h-[100px] max-md:h-[90px] bg-white rounded-xl flex items-center justify-center p-8 border border-slate-200 transition-all duration-300 shadow-[0_1px_3px_rgba(0,0,0,0.08)] hover:-translate-y-1.5 hover:shadow-[0_10px_40px_rgba(0,0,0,0.1)] hover:border-accent"><img src="/assets/logo-rusnac.png" alt="Rusnac" class="max-w-full max-h-[95px] max-lg:max-h-[60px] max-md:max-h-[50px] object-contain grayscale opacity-70 transition-all duration-300 hover:grayscale-0 hover:opacity-100" onerror="this.src='/assets/logo1.png'" /></div>
        <div class="shrink-0 w-[260px] max-lg:w-[160px] max-md:w-[140px] h-[160px] max-lg:h-[100px] max-md:h-[90px] bg-white rounded-xl flex items-center justify-center p-8 border border-slate-200 transition-all duration-300 shadow-[0_1px_3px_rgba(0,0,0,0.08)] hover:-translate-y-1.5 hover:shadow-[0_10px_40px_rgba(0,0,0,0.1)] hover:border-accent"><img src="/assets/logo-marsharcon.png" alt="Marsharcon" class="max-w-full max-h-[95px] max-lg:max-h-[60px] max-md:max-h-[50px] object-contain grayscale opacity-70 transition-all duration-300 hover:grayscale-0 hover:opacity-100" onerror="this.src='/assets/logo1.png'" /></div>
