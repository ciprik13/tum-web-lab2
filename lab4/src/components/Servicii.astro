---
const { data } = Astro.props;

const sectionBadge = data?.services_badge ?? "Ce facem";
const sectionTitle = data?.services_title ?? "Serviciile Noastre";
const sectionSubtitle = data?.services_sub ?? "Solutii complete de la proiectare la finisare";
const serviceCta = data?.service_cta ?? "Solicita Oferta";

const allServices = Array.isArray(data?.services) ? data.services : [];
const visibleServices = allServices.filter((item) => !item?.hidden).slice(0, 5);

const serviceBgClasses = ["service-bg-1", "service-bg-2", "service-bg-3", "service-bg-4", "service-bg-5"];

const specBadge = data?.spec_badge ?? "Specializari";
const specTitle = data?.spec_title ?? "Servicii Complete";
const specSubtitle = data?.spec_sub ?? "Compania noastra ofera o gama larga de constructii metalice";

const specItems = [
  "Carcase pentru cladiri",
  "Tevi tehnologice",
  "Pompe, cisterne si elevatoare",
  "Linii tehnologice verticale si orizontale",
  "Sisteme de incarcare de la sursa primara a carburantilor",
  "Frigidere de pastrare ale fructelor si legumelor",
  "Hale pentru imbutelierea uleiului",
  "Uscatorii de cereale",
  "Noduri de selectie ale boabelor de griu",
  "Scari din metal, balustrade la cladiri comerciale",
  "Hale de pastrare ale apei din sandwich paneluri",
  "Constructii metalice pentru instalatie din PVC",
];
---

<section id="servicii" class="py-[100px] max-md:py-[60px] bg-bg-alt">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="text-center mb-[60px] animate-on-scroll">
      <span class="inline-block text-[0.8rem] font-bold uppercase tracking-[0.15em] text-accent-dark bg-accent/10 px-4 py-1.5 rounded-full mb-4">{sectionBadge}</span>
      <h2 class="text-[clamp(1.8rem,3.5vw,2.5rem)] font-extrabold text-primary mb-3 tracking-tight leading-[1.2]">
        {sectionTitle}
      </h2>
      <p class="text-[1.05rem] text-slate-500 max-w-[550px] mx-auto leading-[1.7]">
        {sectionSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      {visibleServices.map((service, index) => (
        <div
          class={`service-card-new relative rounded-2xl overflow-hidden transition-all duration-300 animate-on-scroll ${serviceBgClasses[index % serviceBgClasses.length]} ${index === 0 ? "h-[380px] lg:h-[450px] lg:col-span-2 max-lg:col-span-1" : "h-[360px] max-md:h-[380px]"}`}
          style={`--delay: ${index * 0.1}s`}
        >
          <div class="relative w-full h-full service-image-wrapper">
            <div class="absolute inset-0 flex items-end service-overlay p-9">
              <div class="relative z-[2]">
                <div class="text-[3.5rem] font-black text-accent opacity-25 leading-none mb-3 transition-all duration-300">
                  {String(index + 1).padStart(2, "0")}
                </div>
                <h3 class={`font-extrabold text-white mb-3 leading-[1.3] ${index === 0 ? "text-2xl lg:text-[1.8rem]" : "text-2xl"}`}>
                  {service?.title}
                </h3>
                <p class="text-base text-white/80 leading-[1.7] mb-5 max-w-[500px]">
                  {service?.desc}
                </p>
                <a href="#contact" class="inline-flex items-center gap-2 text-accent font-bold text-[0.95rem] transition-all duration-300 px-6 py-3 bg-accent/15 rounded-lg border border-accent/30 hover:bg-accent hover:text-primary hover:gap-3 hover:shadow-[0_4px_20px_rgba(240,185,11,0.4)]">
                  {serviceCta}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Mobile-only: Specializari Metalice -->
    <div class="mt-10 md:hidden animate-on-scroll">
      <div class="flex items-center gap-3 mb-6">
        <div class="flex-1 h-px bg-accent/30"></div>
        <h3 class="text-lg font-extrabold tracking-tight text-primary whitespace-nowrap" data-i18n="mobile_metal_heading">Specializari Metalice</h3>
        <div class="flex-1 h-px bg-accent/30"></div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">🏗️</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_1">Carcase pentru cladiri</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">🔧</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_2">Tevi tehnologice</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">⚙️</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_3">Pompe, cisterne si elevatoare</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">📐</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_4">Linii tehnologice</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">⛽</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_5">Sisteme carburanti</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">❄️</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_6">Frigidere fructe & legume</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">🏭</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_7">Hale imbuteliere ulei</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">🌾</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_8">Uscatorii de cereale</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">🔬</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_9">Selectie boabe de griu</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">🪜</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_10">Scari & balustrade metal</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">💧</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_11">Hale sandwich paneluri</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">🏠</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_12">Constructii metalice PVC</span></div>
      </div>
    </div>
  </div>
</section>

<!-- Desktop-only: Servicii Complete -->
<section class="hidden md:block py-[100px]">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="text-center mb-[60px] animate-on-scroll">
      <span class="inline-block text-[0.8rem] font-bold uppercase tracking-[0.15em] text-accent-dark bg-accent/10 px-4 py-1.5 rounded-full mb-4">{specBadge}</span>
      <h2 class="text-[clamp(1.8rem,3.5vw,2.5rem)] font-extrabold text-primary mb-3 tracking-tight leading-[1.2]">{specTitle}</h2>
      <p class="text-[1.05rem] text-slate-500 max-w-[550px] mx-auto leading-[1.7]">{specSubtitle}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-6 max-md:gap-4 mt-[50px]">
      {specItems.map((item, index) => (
        <div class="detailed-service-item flex flex-col items-center justify-center text-center cursor-pointer min-h-[180px] py-10 px-6 rounded-2xl border-2 border-transparent transition-all duration-300 hover:-translate-y-2 hover:border-accent hover:shadow-[0_12px_40px_rgba(15,29,53,0.25)] animate-on-scroll" style={`--delay: ${index * 0.05}s`}>
          <h4 class="relative z-[2] text-[1.1rem] font-bold text-white leading-relaxed m-0">{item}</h4>
        </div>
      ))}
    </div>
  </div>
</section>
