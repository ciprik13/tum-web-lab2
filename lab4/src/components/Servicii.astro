---
// Servicii.astro
---

<section id="servicii" class="py-[100px] max-md:py-[60px] bg-bg-alt">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="text-center mb-[60px] animate-on-scroll">
      <span
        class="inline-block text-[0.8rem] font-bold uppercase tracking-[0.15em] text-accent-dark bg-accent/10 px-4 py-1.5 rounded-full mb-4"
        data-i18n="services_badge"
        >Ce facem</span
      >
      <h2
        class="text-[clamp(1.8rem,3.5vw,2.5rem)] font-extrabold text-primary mb-3 tracking-tight leading-[1.2]"
        data-i18n="services_title"
      >
        Serviciile Noastre
      </h2>
      <p
        class="text-[1.05rem] text-slate-500 max-w-[550px] mx-auto leading-[1.7]"
        data-i18n="services_sub"
      >
        Soluții complete de la proiectare la finisare
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <!-- Service 1 - Large -->
      <div
        class="service-card-new service-bg-1 relative rounded-2xl overflow-hidden h-[380px] lg:h-[450px] lg:col-span-2 max-lg:col-span-1 transition-all duration-300 animate-on-scroll"
        style="--delay: 0s"
      >
        <div class="relative w-full h-full service-image-wrapper">
          <div class="absolute inset-0 flex items-end service-overlay p-9">
            <div class="relative z-[2]">
              <div class="text-[3.5rem] font-black text-accent opacity-25 leading-none mb-3 transition-all duration-300">01</div>
              <h3 class="text-2xl lg:text-[1.8rem] font-extrabold text-white mb-3 leading-[1.3]" data-i18n="service_1_title">Construcții Civile și Inginerești</h3>
              <p class="text-base text-white/80 leading-[1.7] mb-5 max-w-[500px]" data-i18n="service_1_desc">Execuție completă de la fundație la acoperiș pentru clădiri rezidențiale și nerezidențiale</p>
              <a href="#contact" class="inline-flex items-center gap-2 text-accent font-bold text-[0.95rem] transition-all duration-300 px-6 py-3 bg-accent/15 rounded-lg border border-accent/30 hover:bg-accent hover:text-primary hover:gap-3 hover:shadow-[0_4px_20px_rgba(240,185,11,0.4)]" data-i18n="service_cta">
                Solicită Ofertă
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Service 2 -->
      <div class="service-card-new service-bg-2 relative rounded-2xl overflow-hidden h-[360px] max-md:h-[380px] transition-all duration-300 animate-on-scroll" style="--delay: 0.1s">
        <div class="relative w-full h-full service-image-wrapper">
          <div class="absolute inset-0 flex items-end service-overlay p-9">
            <div class="relative z-[2]">
              <div class="text-[3.5rem] font-black text-accent opacity-25 leading-none mb-3">02</div>
              <h3 class="text-2xl font-extrabold text-white mb-3 leading-[1.3]" data-i18n="service_2_title">Construcții Metalice Industriale</h3>
              <p class="text-base text-white/80 leading-[1.7] mb-5 max-w-[500px]" data-i18n="service_2_desc">Hale industriale, platforme și scări metalice</p>
              <a href="#contact" class="inline-flex items-center gap-2 text-accent font-bold text-[0.95rem] transition-all duration-300 px-6 py-3 bg-accent/15 rounded-lg border border-accent/30 hover:bg-accent hover:text-primary hover:gap-3 hover:shadow-[0_4px_20px_rgba(240,185,11,0.4)]" data-i18n="service_cta">
                Solicită Ofertă
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Service 3 -->
      <div class="service-card-new service-bg-3 relative rounded-2xl overflow-hidden h-[360px] max-md:h-[380px] transition-all duration-300 animate-on-scroll" style="--delay: 0.2s">
        <div class="relative w-full h-full service-image-wrapper">
          <div class="absolute inset-0 flex items-end service-overlay p-9">
            <div class="relative z-[2]">
              <div class="text-[3.5rem] font-black text-accent opacity-25 leading-none mb-3">03</div>
              <h3 class="text-2xl font-extrabold text-white mb-3 leading-[1.3]" data-i18n="service_3_title">Instalații și Utilități</h3>
              <p class="text-base text-white/80 leading-[1.7] mb-5 max-w-[500px]" data-i18n="service_3_desc">Electricitate, sanitare și sisteme HVAC</p>
              <a href="#contact" class="inline-flex items-center gap-2 text-accent font-bold text-[0.95rem] transition-all duration-300 px-6 py-3 bg-accent/15 rounded-lg border border-accent/30 hover:bg-accent hover:text-primary hover:gap-3 hover:shadow-[0_4px_20px_rgba(240,185,11,0.4)]" data-i18n="service_cta">
                Solicită Ofertă
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Service 4 -->
      <div class="service-card-new service-bg-4 relative rounded-2xl overflow-hidden h-[360px] max-md:h-[380px] transition-all duration-300 animate-on-scroll" style="--delay: 0.3s">
        <div class="relative w-full h-full service-image-wrapper">
          <div class="absolute inset-0 flex items-end service-overlay p-9">
            <div class="relative z-[2]">
              <div class="text-[3.5rem] font-black text-accent opacity-25 leading-none mb-3">04</div>
              <h3 class="text-2xl font-extrabold text-white mb-3 leading-[1.3]" data-i18n="service_4_title">Logistica Materialelor</h3>
              <p class="text-base text-white/80 leading-[1.7] mb-5 max-w-[500px]" data-i18n="service_4_desc">Furnizare și transport din depozite proprii</p>
              <a href="#contact" class="inline-flex items-center gap-2 text-accent font-bold text-[0.95rem] transition-all duration-300 px-6 py-3 bg-accent/15 rounded-lg border border-accent/30 hover:bg-accent hover:text-primary hover:gap-3 hover:shadow-[0_4px_20px_rgba(240,185,11,0.4)]" data-i18n="service_cta">
                Solicită Ofertă
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Service 5 -->
      <div class="service-card-new service-bg-5 relative rounded-2xl overflow-hidden h-[360px] max-md:h-[380px] transition-all duration-300 animate-on-scroll" style="--delay: 0.4s">
        <div class="relative w-full h-full service-image-wrapper">
          <div class="absolute inset-0 flex items-end service-overlay p-9">
            <div class="relative z-[2]">
              <div class="text-[3.5rem] font-black text-accent opacity-25 leading-none mb-3">05</div>
              <h3 class="text-2xl font-extrabold text-white mb-3 leading-[1.3]" data-i18n="service_5_title">Demolări și Pregătire Teren</h3>
              <p class="text-base text-white/80 leading-[1.7] mb-5 max-w-[500px]" data-i18n="service_5_desc">Curățare, demolare și nivelare pentru șantier</p>
              <a href="#contact" class="inline-flex items-center gap-2 text-accent font-bold text-[0.95rem] transition-all duration-300 px-6 py-3 bg-accent/15 rounded-lg border border-accent/30 hover:bg-accent hover:text-primary hover:gap-3 hover:shadow-[0_4px_20px_rgba(240,185,11,0.4)]" data-i18n="service_cta">
                Solicită Ofertă
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile-only: Specializări Metalice -->
    <div class="mt-10 md:hidden animate-on-scroll">
      <div class="flex items-center gap-3 mb-6">
        <div class="flex-1 h-px bg-accent/30"></div>
        <h3 class="text-lg font-extrabold tracking-tight text-primary whitespace-nowrap" data-i18n="mobile_metal_heading">Specializări Metalice</h3>
        <div class="flex-1 h-px bg-accent/30"></div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">🏗️</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_1">Carcase pentru clădiri</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">🔧</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_2">Țevi tehnologice</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">⚙️</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_3">Pompe, cisterne și elevatoare</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">📐</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_4">Linii tehnologice</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">⛽</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_5">Sisteme carburanți</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">❄️</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_6">Frigidere fructe & legume</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">🏭</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_7">Hale îmbuteliere ulei</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">🌾</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_8">Uscătorii de cereale</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">🔬</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_9">Selecție boabe de grîu</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">🪜</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_10">Scări & balustrade metal</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">💧</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_11">Hale sandwich paneluri</span></div>
        <div class="flex flex-col items-center gap-2 p-4 text-center transition-all duration-300 bg-white border shadow-sm mobile-service-card rounded-xl border-slate-200 hover:border-accent hover:shadow-md hover:-translate-y-1"><span class="text-2xl">🏠</span><span class="text-[0.82rem] font-semibold text-primary leading-snug" data-i18n="mobile_svc_12">Construcții metalice PVC</span></div>
      </div>
    </div>
  </div>
</section>

<!-- Desktop-only: Servicii Complete -->
<section class="hidden md:block py-[100px]">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="text-center mb-[60px] animate-on-scroll">
      <span class="inline-block text-[0.8rem] font-bold uppercase tracking-[0.15em] text-accent-dark bg-accent/10 px-4 py-1.5 rounded-full mb-4" data-i18n="spec_badge">Specializări</span>
      <h2 class="text-[clamp(1.8rem,3.5vw,2.5rem)] font-extrabold text-primary mb-3 tracking-tight leading-[1.2]" data-i18n="spec_title">Servicii Complete</h2>
      <p class="text-[1.05rem] text-slate-500 max-w-[550px] mx-auto leading-[1.7]" data-i18n="spec_sub">Compania noastră oferă o gamă largă de construcții metalice</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-6 max-md:gap-4 mt-[50px]">
      <div class="detailed-service-item flex flex-col items-center justify-center text-center cursor-pointer min-h-[180px] py-10 px-6 rounded-2xl border-2 border-transparent transition-all duration-300 hover:-translate-y-2 hover:border-accent hover:shadow-[0_12px_40px_rgba(15,29,53,0.25)] animate-on-scroll" style="--delay: 0s"><h4 class="relative z-[2] text-[1.1rem] font-bold text-white leading-relaxed m-0" data-i18n="spec_item_1">Carcase pentru clădiri</h4></div>
      <div class="detailed-service-item flex flex-col items-center justify-center text-center cursor-pointer min-h-[180px] py-10 px-6 rounded-2xl border-2 border-transparent transition-all duration-300 hover:-translate-y-2 hover:border-accent hover:shadow-[0_12px_40px_rgba(15,29,53,0.25)] animate-on-scroll" style="--delay: 0.05s"><h4 class="relative z-[2] text-[1.1rem] font-bold text-white leading-relaxed m-0" data-i18n="spec_item_2">Tevi tehnologice</h4></div>
      <div class="detailed-service-item flex flex-col items-center justify-center text-center cursor-pointer min-h-[180px] py-10 px-6 rounded-2xl border-2 border-transparent transition-all duration-300 hover:-translate-y-2 hover:border-accent hover:shadow-[0_12px_40px_rgba(15,29,53,0.25)] animate-on-scroll" style="--delay: 0.1s"><h4 class="relative z-[2] text-[1.1rem] font-bold text-white leading-relaxed m-0" data-i18n="spec_item_3">Pompe, cisterne și elevatoare</h4></div>
      <div class="detailed-service-item flex flex-col items-center justify-center text-center cursor-pointer min-h-[180px] py-10 px-6 rounded-2xl border-2 border-transparent transition-all duration-300 hover:-translate-y-2 hover:border-accent hover:shadow-[0_12px_40px_rgba(15,29,53,0.25)] animate-on-scroll" style="--delay: 0.15s"><h4 class="relative z-[2] text-[1.1rem] font-bold text-white leading-relaxed m-0" data-i18n="spec_item_4">Linii tehnologice verticale și orizontale</h4></div>
      <div class="detailed-service-item flex flex-col items-center justify-center text-center cursor-pointer min-h-[180px] py-10 px-6 rounded-2xl border-2 border-transparent transition-all duration-300 hover:-translate-y-2 hover:border-accent hover:shadow-[0_12px_40px_rgba(15,29,53,0.25)] animate-on-scroll" style="--delay: 0.2s"><h4 class="relative z-[2] text-[1.1rem] font-bold text-white leading-relaxed m-0" data-i18n="spec_item_5">Sisteme de încărcare de la sursă primară a carburanților</h4></div>
      <div class="detailed-service-item flex flex-col items-center justify-center text-center cursor-pointer min-h-[180px] py-10 px-6 rounded-2xl border-2 border-transparent transition-all duration-300 hover:-translate-y-2 hover:border-accent hover:shadow-[0_12px_40px_rgba(15,29,53,0.25)] animate-on-scroll" style="--delay: 0.25s"><h4 class="relative z-[2] text-[1.1rem] font-bold text-white leading-relaxed m-0" data-i18n="spec_item_6">Frigidere de păstrare ale fructelor și legumelor</h4></div>
      <div class="detailed-service-item flex flex-col items-center justify-center text-center cursor-pointer min-h-[180px] py-10 px-6 rounded-2xl border-2 border-transparent transition-all duration-300 hover:-translate-y-2 hover:border-accent hover:shadow-[0_12px_40px_rgba(15,29,53,0.25)] animate-on-scroll" style="--delay: 0.3s"><h4 class="relative z-[2] text-[1.1rem] font-bold text-white leading-relaxed m-0" data-i18n="spec_item_7">Hale pentru îmbutelierea uleiului</h4></div>
      <div class="detailed-service-item flex flex-col items-center justify-center text-center cursor-pointer min-h-[180px] py-10 px-6 rounded-2xl border-2 border-transparent transition-all duration-300 hover:-translate-y-2 hover:border-accent hover:shadow-[0_12px_40px_rgba(15,29,53,0.25)] animate-on-scroll" style="--delay: 0.35s"><h4 class="relative z-[2] text-[1.1rem] font-bold text-white leading-relaxed m-0" data-i18n="spec_item_8">Uscătorii de cereale</h4></div>
      <div class="detailed-service-item flex flex-col items-center justify-center text-center cursor-pointer min-h-[180px] py-10 px-6 rounded-2xl border-2 border-transparent transition-all duration-300 hover:-translate-y-2 hover:border-accent hover:shadow-[0_12px_40px_rgba(15,29,53,0.25)] animate-on-scroll" style="--delay: 0.4s"><h4 class="relative z-[2] text-[1.1rem] font-bold text-white leading-relaxed m-0" data-i18n="spec_item_9">Noduri de selecție ale boabelor de griu</h4></div>
      <div class="detailed-service-item flex flex-col items-center justify-center text-center cursor-pointer min-h-[180px] py-10 px-6 rounded-2xl border-2 border-transparent transition-all duration-300 hover:-translate-y-2 hover:border-accent hover:shadow-[0_12px_40px_rgba(15,29,53,0.25)] animate-on-scroll" style="--delay: 0.45s"><h4 class="relative z-[2] text-[1.1rem] font-bold text-white leading-relaxed m-0" data-i18n="spec_item_10">Scări din metal, balustrade la clădiri comerciale</h4></div>
      <div class="detailed-service-item flex flex-col items-center justify-center text-center cursor-pointer min-h-[180px] py-10 px-6 rounded-2xl border-2 border-transparent transition-all duration-300 hover:-translate-y-2 hover:border-accent hover:shadow-[0_12px_40px_rgba(15,29,53,0.25)] animate-on-scroll" style="--delay: 0.5s"><h4 class="relative z-[2] text-[1.1rem] font-bold text-white leading-relaxed m-0" data-i18n="spec_item_11">Hale de păstrare ale apei din sandwich paneluri</h4></div>
      <div class="detailed-service-item flex flex-col items-center justify-center text-center cursor-pointer min-h-[180px] py-10 px-6 rounded-2xl border-2 border-transparent transition-all duration-300 hover:-translate-y-2 hover:border-accent hover:shadow-[0_12px_40px_rgba(15,29,53,0.25)] animate-on-scroll" style="--delay: 0.55s"><h4 class="relative z-[2] text-[1.1rem] font-bold text-white leading-relaxed m-0" data-i18n="spec_item_12">Construcții metalice pentru instalație din PVC</h4></div>
    </div>
  </div>
</section>