---
export interface Props {
  title?: string;
  lang?: string;
}

const {
  title = "S.C. DARION-NORD S.R.L. - Construcții și Materiale",
  lang = "ro",
} = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="/assets/logo1.png" type="image/png" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body class="overflow-x-hidden bg-white font-inter text-slate-700">

    <!-- NAV SHELL -->
    <header id="navbar" class="fixed top-0 inset-x-0 z-[1000] bg-white/95 backdrop-blur-[20px] border-b border-transparent py-3.5">
      <!-- nav content will be migrated in PR 3 (base layout) and populated per-section -->
    </header>

    <!-- PAGE CONTENT -->
    <main>
      <slot />
    </main>

    <!-- FOOTER SHELL -->
    <footer class="text-white bg-primary">
      <!-- footer content will be migrated in its own PR -->
    </footer>

  </body>
</html>